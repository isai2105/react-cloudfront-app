{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    /* Playwright code straddles two runtimes: the test runner is Node, and
       the callbacks handed to page.evaluate / page.addInitScript run in the
       browser. Neither tsconfig.app.json (DOM, no node) nor
       tsconfig.node.json (node, no DOM) fits, hence a third project. */
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    /* Same three flags as tsconfig.app.json, for the same reason. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* The suites import scripts/lib/csp.mjs; allowJs types it from its JSDoc. */
    "allowJs": true
  },
  "include": ["playwright.config.ts", "playwright.live.config.ts", "e2e"]
}
