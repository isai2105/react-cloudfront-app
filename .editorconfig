# EditorConfig — https://editorconfig.org
# Formatting baseline for this repository, kept in step with the sibling
# terraform-aws-static-site so both repos feel identical to an editor. Prettier
# owns the details for source files; this covers what it does not touch.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown; keep them.
trim_trailing_whitespace = false
